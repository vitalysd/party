# App Config
PROJECT_NAME="Пати — рядом со своими"
ENVIRONMENT=development
SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pati_user
POSTGRES_PASSWORD=pati_secret_password
POSTGRES_DB=pati_db
DATABASE_URL=postgresql+asyncpg://pati_user:pati_secret_password@postgres:5432/pati_db

# MinIO (S3 Storage)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET_NAME=pati-uploads

# LiveKit WebRTC
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_key_must_be_at_least_32_characters_long_for_dev

# Backend Port
BACKEND_PORT=8000
